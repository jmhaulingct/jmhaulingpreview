<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="JM Hauling makes junk removal simple. Upload photos for a free quote in Waterbury, CT and surrounding communities.">
  <title>JM Hauling | Junk Removal Made Simple</title>
  <style>
    :root{
      --navy:#062d61;--navy2:#031c3d;--blue:#0b5fb3;--green:#2d8b57;
      --ink:#152033;--muted:#667085;--line:#dbe3ee;--soft:#f5f8fc;--white:#fff;
      --shadow:0 18px 48px rgba(3,28,61,.14);--radius:22px
    }
    *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);line-height:1.5;background:#fff} img{display:block;max-width:100%} a{color:inherit} button,input,select,textarea{font:inherit}.container{width:min(1080px,calc(100% - 28px));margin:auto}
    .topbar{padding:8px 14px;text-align:center;background:var(--navy2);color:#fff;font-size:.86rem;font-weight:750}
    .nav{height:70px;background:rgba(255,255,255,.96);border-bottom:1px solid rgba(219,227,238,.9);display:flex;align-items:center;position:sticky;top:0;z-index:20;backdrop-filter:blur(12px)}
    .nav-inner{display:flex;align-items:center;justify-content:space-between;gap:16px}.logo img{width:52px;height:52px;object-fit:contain;border-radius:50%}.nav-contact{font-weight:850;color:var(--navy);text-decoration:none;font-size:.94rem}
    .hero{color:#fff;background:linear-gradient(90deg,rgba(3,28,61,.95),rgba(3,28,61,.78) 55%,rgba(3,28,61,.18)),url('assets/full-trailer.jpg') center 55%/cover no-repeat;padding:56px 0 72px}
    .hero-content{max-width:690px}.eyebrow{margin:0 0 10px;text-transform:uppercase;letter-spacing:.13em;font-size:.76rem;font-weight:900;color:#b8dcff}.hero h1{font-size:clamp(2.55rem,8vw,4.8rem);line-height:1.02;letter-spacing:-.045em;margin:0 0 18px}.hero p{font-size:clamp(1.05rem,2vw,1.22rem);color:rgba(255,255,255,.91);max-width:630px;margin:0 0 24px}.hero-actions{display:flex;flex-wrap:wrap;gap:10px}.btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:14px;padding:15px 20px;font-weight:900;text-decoration:none;cursor:pointer}.btn-light{background:#fff;color:var(--navy);box-shadow:0 10px 24px rgba(0,0,0,.16)}.btn-primary{background:var(--navy);color:#fff}.btn-outline{border:2px solid rgba(255,255,255,.72);color:#fff;background:rgba(255,255,255,.08)}.promise{margin-top:20px;font-size:.93rem;font-weight:750;color:rgba(255,255,255,.83)}
    .quote-shell{margin-top:-34px;position:relative;z-index:5}.quote-card{background:#fff;border:1px solid var(--line);border-radius:26px;box-shadow:var(--shadow);overflow:hidden}.quote-head{padding:26px 28px 18px;border-bottom:1px solid var(--line)}.quote-head h2{font-size:clamp(1.75rem,4vw,2.45rem);letter-spacing:-.035em;margin:0 0 6px}.quote-head p{margin:0;color:var(--muted)}.form-panel{padding:24px 28px 28px}.demo{background:#fff6dc;color:#6a4e00;padding:10px 12px;border-radius:10px;font-size:.82rem;margin-bottom:18px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{display:grid;gap:7px}.field.full,.submit{grid-column:1/-1}label{font-size:.91rem;font-weight:850}input,select,textarea{width:100%;border:1px solid #cbd6e4;border-radius:12px;padding:13px 14px;background:#fbfcfe;color:var(--ink);outline:none}input:focus,select:focus,textarea:focus{border-color:var(--blue);box-shadow:0 0 0 4px rgba(11,95,179,.1)}textarea{min-height:108px;resize:vertical}.hint{font-size:.8rem;color:var(--muted);margin:0}.submit .btn{width:100%;padding:16px;border-radius:12px}.previews{display:flex;gap:8px;flex-wrap:wrap;margin-top:9px}.previews img{width:66px;height:66px;border-radius:9px;object-fit:cover;border:1px solid var(--line)}.success{display:none;margin-top:14px;padding:13px;border-radius:11px;background:#eaf7ef;color:#185b38;font-weight:800}
    .next{padding:22px 28px;background:var(--navy2);color:#fff}.next h3{margin:0 0 12px;font-size:1.2rem}.next-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.next-item{display:flex;gap:10px;align-items:flex-start}.num{width:27px;height:27px;flex:0 0 27px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.14);font-weight:900}.next-item p{margin:2px 0 0;color:rgba(255,255,255,.77);font-size:.86rem}
    section{padding:66px 0}.section-intro{max-width:680px;margin-bottom:28px}.section-intro h2{font-size:clamp(2rem,5vw,3rem);line-height:1.05;letter-spacing:-.04em;margin:0 0 10px}.section-intro p{color:var(--muted);margin:0}
    .services{background:var(--soft)}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.service{background:#fff;border:1px solid var(--line);border-radius:20px;padding:25px;box-shadow:0 8px 28px rgba(3,28,61,.055)}.service .icon{font-size:1.5rem;margin-bottom:18px}.service h3{margin:0 0 8px}.service p{margin:0;color:var(--muted);font-size:.94rem}
    .gallery{display:grid;grid-template-columns:1.25fr .75fr .75fr;grid-template-rows:255px 255px;gap:12px}.gallery figure{margin:0;border-radius:18px;overflow:hidden;position:relative;background:#dfe6ef}.gallery figure:first-child{grid-row:1/3}.gallery img{width:100%;height:100%;object-fit:cover}.gallery figcaption{position:absolute;left:10px;right:10px;bottom:10px;padding:9px 11px;border-radius:10px;color:#fff;background:rgba(3,28,61,.78);font-size:.84rem;font-weight:850;backdrop-filter:blur(6px)}
    .reviews{background:var(--navy);color:#fff}.reviews-row{display:flex;align-items:center;justify-content:space-between;gap:24px}.reviews h2{font-size:clamp(2rem,5vw,3rem);letter-spacing:-.04em;margin:0 0 8px}.reviews p{margin:0;color:rgba(255,255,255,.78)}.reviews .btn{background:#fff;color:var(--navy);white-space:nowrap}
    .faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}details{border:1px solid var(--line);border-radius:14px;padding:17px 19px;background:#fff}summary{font-weight:850;color:var(--navy);cursor:pointer}details p{margin:10px 0 0;color:var(--muted)}
    footer{background:var(--navy2);color:rgba(255,255,255,.72);padding:30px 0;font-size:.88rem}.footer-row{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}.footer-row img{width:46px;height:46px;border-radius:50%}.footer-links{display:flex;gap:16px;flex-wrap:wrap}.footer-links a{color:#fff;text-decoration:none}

    .progress-wrap{padding:22px 28px 0}.progress-meta{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px;font-size:.84rem;font-weight:850;color:var(--navy)}
    .progress-track{height:8px;background:#e8edf4;border-radius:999px;overflow:hidden}.progress-bar{height:100%;width:33.333%;background:linear-gradient(90deg,var(--blue),var(--navy));border-radius:999px;transition:width .3s ease}
    .form-step{display:none;animation:stepIn .24s ease}.form-step.active{display:block}@keyframes stepIn{from{opacity:0;transform:translateX(12px)}to{opacity:1;transform:translateX(0)}}
    .step-title{margin:0 0 5px;font-size:1.45rem;letter-spacing:-.025em}.step-subtitle{margin:0 0 20px;color:var(--muted)}
    .step-actions{display:flex;gap:10px;margin-top:20px}.step-actions .btn{flex:1}.btn-muted{background:#edf2f8;color:var(--navy)}
    .choice-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.choice{position:relative}.choice input{position:absolute;opacity:0;pointer-events:none}.choice label{display:flex;align-items:center;justify-content:center;min-height:52px;text-align:center;border:1px solid #cbd6e4;border-radius:12px;background:#fbfcfe;padding:10px;cursor:pointer;transition:.15s}
    .choice input:checked+label{border-color:var(--navy);background:#eaf2fb;color:var(--navy);box-shadow:0 0 0 3px rgba(11,95,179,.09)}
    .date-note{margin-top:7px;font-size:.78rem;color:var(--muted)}
    .photo-drop{border:2px dashed #b8c5d6;border-radius:16px;padding:22px;text-align:center;background:#fbfcfe}.photo-drop input{margin-top:12px;background:#fff}
    .screen-note{display:flex;gap:10px;align-items:flex-start;background:#eef5fd;color:#174d84;border-radius:12px;padding:13px 14px;margin-top:16px;font-size:.86rem}

    @media(max-width:820px){.service-grid{grid-template-columns:1fr}.gallery{grid-template-columns:1fr 1fr;grid-template-rows:300px 220px 220px}.gallery figure:first-child{grid-column:1/-1;grid-row:auto}.reviews-row{align-items:flex-start;flex-direction:column}.faq-grid{grid-template-columns:1fr}}
    @media(max-width:620px){.topbar{font-size:.77rem}.nav{height:64px}.logo img{width:46px;height:46px}.nav-contact{font-size:.82rem}.hero{padding:42px 0 70px;background:linear-gradient(0deg,rgba(3,28,61,.97),rgba(3,28,61,.72) 72%,rgba(3,28,61,.26)),url('assets/full-trailer.jpg') 57% center/cover no-repeat}.hero-actions .btn{width:100%}.quote-shell{margin-top:-38px}.quote-head,.form-panel,.next{padding-left:19px;padding-right:19px}.form-grid{grid-template-columns:1fr}.field.full,.submit{grid-column:auto}.step-actions{flex-direction:column-reverse}.next-grid{grid-template-columns:1fr;gap:11px}.choice-grid{grid-template-columns:1fr 1fr}section{padding:54px 0}.gallery{grid-template-columns:1fr;grid-template-rows:repeat(4,250px)}.gallery figure:first-child{grid-column:auto}.footer-row{align-items:flex-start}}
  </style>
</head>
<body>
  <div class="topbar">Serving Waterbury and surrounding Connecticut communities</div>
  <nav class="nav">
    <div class="container nav-inner">
      <a class="logo" href="#top" aria-label="JM Hauling home"><img src="assets/logo.png" alt="JM Hauling logo"></a>
      <a class="nav-contact" href="tel:+18603412003">Call or Text: 860-341-2003</a>
    </div>
  </nav>

  <main id="top">
    <header class="hero">
      <div class="container hero-content">
        <p class="eyebrow">Fast, photo-based quotes</p>
        <h1>Junk Removal<br>Made Simple.</h1>
        <p>Upload a few photos, tell us what needs to go, and we'll review your job and get back to you with a free quote.</p>
        <div class="hero-actions">
          <a class="btn btn-light" href="#quote">📸 Get My Free Quote</a>
          <a class="btn btn-outline" href="sms:+18603412003">Call or Text</a>
        </div>
        <div class="promise">No obligation. No hidden fees. Just a clear quote based on the details you send.</div>
      </div>
    </header>

    <div class="quote-shell" id="quote">
      <div class="container">
        <div class="quote-card">
          <div class="quote-head">
            <h2>Tell us about your job.</h2>
            <p>The form starts here—no searching, no waiting through a long conversation.</p>
          </div>
          <div class="progress-wrap">
            <div class="progress-meta"><span id="stepLabel">Step 1 of 3</span><span id="stepName">Contact</span></div>
            <div class="progress-track"><div class="progress-bar" id="progressBar"></div></div>
          </div>
          <div class="form-panel">
            <div class="demo"><strong>Preview mode:</strong> Test the complete step-by-step experience. Submissions are not being sent yet.</div>
            <form id="quoteForm" novalidate>
              <section class="form-step active" data-step="1">
                <h3 class="step-title">How can we reach you?</h3>
                <p class="step-subtitle">Just the basics so we know who the quote is for.</p>
                <div class="form-grid">
                  <div class="field"><label for="name">Name *</label><input id="name" name="name" required autocomplete="name" placeholder="Your name"></div>
                  <div class="field"><label for="phone">Phone number *</label><input id="phone" name="phone" required type="tel" autocomplete="tel" placeholder="(203) 555-0123"></div>
                  <div class="field full"><label for="town">Town *</label><select id="town" name="town" required><option value="">Select your town</option><option>Waterbury</option><option>Prospect</option><option>Naugatuck</option><option>Cheshire</option><option>Southington</option><option>Meriden</option><option>Bethany</option><option>Bristol</option><option>Thomaston</option><option>Wolcott</option><option>Watertown</option><option>New Haven</option><option>Hamden</option><option>New Britain</option><option>Other nearby town</option></select></div>
                </div>
                <div class="step-actions"><button class="btn btn-primary next-step" type="button">Continue</button></div>
              </section>

              <section class="form-step" data-step="2">
                <h3 class="step-title">Tell us about the job.</h3>
                <p class="step-subtitle">This helps us understand the labor, access and timing.</p>
                <div class="form-grid">
                  <div class="field full"><label for="description">What needs to be removed? *</label><textarea id="description" name="description" required placeholder="Describe the items, amount, heavy materials, stairs, parking distance, or anything else we should know."></textarea></div>
                  <div class="field"><label for="location">Where are the items? *</label><select id="location" name="location" required><option value="">Choose one</option><option>Curb or driveway</option><option>Garage</option><option>First floor</option><option>Upstairs</option><option>Basement</option><option>Attic</option><option>Storage unit</option><option>Multiple locations</option><option>Other</option></select></div>
                  <div class="field"><label for="preferredDate">Preferred date</label><input id="preferredDate" name="preferredDate" type="date"><p class="date-note">Your appointment is not confirmed until JM Hauling contacts you.</p></div>
                  <div class="field full">
                    <label>How soon do you need it removed?</label>
                    <div class="choice-grid">
                      <div class="choice"><input type="radio" id="urgency-asap" name="urgency" value="ASAP" checked><label for="urgency-asap">ASAP</label></div>
                      <div class="choice"><input type="radio" id="urgency-days" name="urgency" value="Within 2–3 days"><label for="urgency-days">Within 2–3 days</label></div>
                      <div class="choice"><input type="radio" id="urgency-week" name="urgency" value="This week"><label for="urgency-week">This week</label></div>
                      <div class="choice"><input type="radio" id="urgency-flex" name="urgency" value="Flexible"><label for="urgency-flex">Flexible</label></div>
                    </div>
                  </div>
                </div>
                <div class="step-actions"><button class="btn btn-muted prev-step" type="button">Back</button><button class="btn btn-primary next-step" type="button">Continue</button></div>
              </section>

              <section class="form-step" data-step="3">
                <h3 class="step-title">Add photos and you're done.</h3>
                <p class="step-subtitle">Show the full amount, access path and any stairs or oversized items.</p>
                <div class="photo-drop">
                  <strong>Upload clear job photos *</strong>
                  <p class="hint">Multiple angles help us give you a more accurate quote.</p>
                  <input id="photos" name="photos" type="file" accept="image/*" multiple required>
                  <p class="hint" id="fileStatus">No photos selected yet.</p>
                  <div class="previews" id="previews"></div>
                </div>
                <div class="screen-note"><span>✓</span><span>After submission, we'll review everything and contact you with a quote or let you know if an in-person estimate is needed.</span></div>
                <div class="step-actions"><button class="btn btn-muted prev-step" type="button">Back</button><button class="btn btn-primary" type="submit">Get My Free Quote</button></div>
                <div class="success" id="success">Demo complete. The live version will save your request and photos, then alert JM Hauling.</div>
              </section>
            </form>
          </div>
          <div class="next">
            <h3>What happens next?</h3>
            <div class="next-grid">
              <div class="next-item"><div class="num">1</div><div><strong>We review your photos.</strong><p>We look at volume, access and the type of material.</p></div></div>
              <div class="next-item"><div class="num">2</div><div><strong>We contact you.</strong><p>You'll receive a quote or a request for a few extra details.</p></div></div>
              <div class="next-item"><div class="num">3</div><div><strong>You choose what works.</strong><p>Approve the quote and schedule a convenient removal time.</p></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="services">
      <div class="container">
        <div class="section-intro"><h2>We remove almost anything.</h2><p>From everyday clutter to full cleanouts and larger outdoor projects, JM Hauling handles the lifting, loading and removal.</p></div>
        <div class="service-grid">
          <article class="service"><div class="icon">🛋️</div><h3>Household Junk</h3><p>Furniture, appliances, mattresses, boxes and unwanted items throughout the home.</p></article>
          <article class="service"><div class="icon">🏠</div><h3>Property Cleanouts</h3><p>Basements, garages, apartments, estates, storage spaces and renovation debris.</p></article>
          <article class="service"><div class="icon">🛠️</div><h3>Large Item Removal</h3><p>Oversized items and outdoor structures, including hot tubs, sheds, above-ground pools, playsets and more.</p></article>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <div class="section-intro"><h2>Real jobs. Real results.</h2><p>No stock photos—just a look at the work JM Hauling handles for customers across the area.</p></div>
        <div class="gallery">
          <figure><img src="assets/full-trailer.jpg" alt="JM Hauling trailer fully loaded after a junk removal job"><figcaption>Full-load junk removal</figcaption></figure>
          <figure><img src="assets/commercial-pickup.jpg" alt="JM Hauling truck and trailer at a completed pickup"><figcaption>Property pickup</figcaption></figure>
          <figure><img src="assets/furniture-removal.jpg" alt="Furniture loaded for removal"><figcaption>Furniture removal</figcaption></figure>
          <figure><img src="assets/owner-trailer.jpg" alt="JM Hauling owner beside a loaded trailer"><figcaption>Owner-operated service</figcaption></figure>
        </div>
      </div>
    </section>

    <section class="reviews">
      <div class="container reviews-row">
        <div><h2>See what customers are saying.</h2><p>Read feedback from people who have hired JM Hauling.</p></div>
        <a class="btn" href="https://share.google/1HnQpMDuiQS5CdBlY" target="_blank" rel="noopener">Read Our Google Reviews</a>
      </div>
    </section>

    <section>
      <div class="container">
        <div class="section-intro"><h2>Quick answers.</h2></div>
        <div class="faq-grid">
          <details><summary>Do I need to be home?</summary><p>Not always. Curbside and driveway pickups may be completed without you present once the details and payment arrangements are confirmed.</p></details>
          <details><summary>Can you remove items from basements or upstairs?</summary><p>Yes. Include photos of stairs, hallways and tight access points so the quote reflects the work required.</p></details>
          <details><summary>How quickly can my junk be removed?</summary><p>Availability depends on the job and schedule. Choose your preferred timeframe in the form and JM Hauling will confirm what is available.</p></details>
          <details><summary>Can every job be quoted from photos?</summary><p>Many can. Larger or more complex projects may require a free in-person estimate before final pricing.</p></details>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-row">
      <img src="assets/logo.png" alt="JM Hauling logo">
      <div>Serving Waterbury and surrounding Connecticut communities.</div>
      <div class="footer-links"><a href="tel:+18603412003">Call</a><a href="sms:+18603412003">Text</a><a href="https://share.google/1HnQpMDuiQS5CdBlY" target="_blank" rel="noopener">Google Reviews</a></div>
    </div>
  </footer>

  <script>
    const steps=[...document.querySelectorAll('.form-step')];
    const progressBar=document.getElementById('progressBar');
    const stepLabel=document.getElementById('stepLabel');
    const stepName=document.getElementById('stepName');
    const quoteCard=document.querySelector('.quote-card');
    const names=['Contact','Job details','Photos'];
    let currentStep=0;

    function showStep(index){
      currentStep=index;
      steps.forEach((step,i)=>step.classList.toggle('active',i===index));
      stepLabel.textContent=`Step ${index+1} of ${steps.length}`;
      stepName.textContent=names[index];
      progressBar.style.width=`${((index+1)/steps.length)*100}%`;
      quoteCard.scrollIntoView({behavior:'smooth',block:'start'});
    }

    function validateStep(index){
      const required=[...steps[index].querySelectorAll('[required]')];
      for(const field of required){
        if(field.type==='file' && field.files.length===0){
          field.setCustomValidity('Please upload at least one photo.');
        }else{
          field.setCustomValidity('');
        }
        if(!field.checkValidity()){
          field.reportValidity();
          return false;
        }
      }
      return true;
    }

    document.querySelectorAll('.next-step').forEach(button=>{
      button.addEventListener('click',()=>{
        if(validateStep(currentStep)) showStep(Math.min(currentStep+1,steps.length-1));
      });
    });

    document.querySelectorAll('.prev-step').forEach(button=>{
      button.addEventListener('click',()=>showStep(Math.max(currentStep-1,0)));
    });

    const photos=document.getElementById('photos');
    const previews=document.getElementById('previews');
    const status=document.getElementById('fileStatus');

    photos.addEventListener('change',()=>{
      previews.innerHTML='';
      const files=[...photos.files];
      photos.setCustomValidity('');
      status.textContent=files.length?`${files.length} photo${files.length===1?'':'s'} selected.`:'No photos selected yet.';
      files.slice(0,8).forEach(file=>{
        const img=document.createElement('img');
        img.alt='Selected photo preview';
        img.src=URL.createObjectURL(file);
        previews.appendChild(img);
      });
    });

    const dateInput=document.getElementById('preferredDate');
    const today=new Date();
    const localISO=new Date(today.getTime()-today.getTimezoneOffset()*60000).toISOString().split('T')[0];
    dateInput.min=localISO;

    document.getElementById('quoteForm').addEventListener('submit',e=>{
      e.preventDefault();
      if(!validateStep(2)) return;
      document.getElementById('success').style.display='block';
      document.getElementById('success').scrollIntoView({behavior:'smooth',block:'center'});
    });
  </script>
  <div style="position:fixed;right:12px;bottom:12px;z-index:50;background:#fff6dc;color:#6a4e00;border:1px solid #ead99f;padding:7px 10px;border-radius:999px;font-size:.72rem;font-weight:850;box-shadow:0 5px 18px rgba(0,0,0,.12)">PREVIEW v1.1</div>
</body>
